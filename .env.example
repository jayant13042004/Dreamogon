# SUBCONSCIOUS LOG

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role — required for Stripe webhooks to sync plan_tier (server only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=your_gemini_api_key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Billing (provider-agnostic app layer; Stripe is the first adapter)
BILLING_PROVIDER=stripe
BILLING_CURRENCY=usd
NEXT_PUBLIC_PRO_PRICE_DISPLAY=9

# Stripe (global Checkout / Billing / Customer Portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_LIFETIME=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public Support & Legal Contacts (optional; displays pending indicator if unset)
NEXT_PUBLIC_SUPPORT_EMAIL=support@subconsciouslog.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@subconsciouslog.com
NEXT_PUBLIC_SECURITY_EMAIL=security@subconsciouslog.com

# Cloudflare Workers / OpenNext
# Mirror the vars above in Workers → Settings → Variables / Secrets (`wrangler secret put`).
# Keep middleware.ts (do not rename to proxy.ts until OpenNext fully supports it).
