# SUBCONSCIOUS LOG - Environment Configuration

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role — required for Webhooks to sync plan_tier (server only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# App URL (set this to your custom domain on Cloudflare e.g. https://subconsciouslog.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Billing Provider Configuration
# Options: 'dodo' or 'stripe'
BILLING_PROVIDER=dodo
BILLING_CURRENCY=usd
NEXT_PUBLIC_PRO_PRICE_DISPLAY=9

# Dodo Payments (Recommended for global checkouts & edge compatibility)
# Set environment to 'test_mode' for testing or 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID_PRO_MONTHLY=
DODO_PRODUCT_ID_PRO_ANNUAL=

# Stripe (Alternative provider)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public Support & Legal Contacts
NEXT_PUBLIC_SUPPORT_EMAIL=support@subconsciouslog.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@subconsciouslog.com
NEXT_PUBLIC_SECURITY_EMAIL=security@subconsciouslog.com

# Cloudflare Deployment
# 1. Build: npm run cf:build
# 2. Deploy: npx wrangler deploy
# 3. Add secrets to Cloudflare Workers via Wrangler CLI or Dashboard:
#    npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#    npx wrangler secret put GEMINI_API_KEY
#    npx wrangler secret put DODO_PAYMENTS_API_KEY
#    npx wrangler secret put DODO_PAYMENTS_WEBHOOK_KEY
